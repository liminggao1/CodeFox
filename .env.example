# API Key (required)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxx

# Model ID (required)
MODEL_ID=claude-sonnet-4-6

# Optional long-term memory (recall, extraction and consolidation).
# Disabled by default so a completed turn does not make another model request.
# AGENT_MEMORY_ENABLED=1

# Base URL (optional, for Anthropic-compatible providers)
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Goal evaluator (optional; set to jev to use Jev's typed decision API)
# GOAL_EVALUATOR_PROVIDER=jev
# JEV_API_KEY=sk_...
# JEV_MODEL=typesafe/jev-1.13
# JEV_API_URL=https://thejevai.com/v1/systemone
# JEV_TIMEOUT_SECONDS=30
# JEV_COMPLETION_CONFIDENCE_THRESHOLD=0.9
# GOAL_EVALUATOR_MAX_TRANSCRIPT_CHARACTERS=24000

# =============================================================================
#  Wire protocol switch (optional)
#
#  Every chapter builds its client through llm_client.py, which exposes the
#  same messages.create call in either direction. Default is the Anthropic
#  Messages protocol, so nothing changes unless you opt in.
#
#  Set LLM_API=responses to talk to any OpenAI Responses API endpoint
#  (POST /v1/responses) instead. Useful when a provider or relay exposes
#  /v1/chat/completions and /v1/responses but denies /v1/messages.
#
#  LLM_API=responses           # unset = Anthropic Messages (default)
#  OPENAI_BASE_URL=...         # endpoint for responses mode
#  OPENAI_API_KEY=...          # falls back to ANTHROPIC_API_KEY if unset
#
#  LLM_RESPONSES_URL wins over OPENAI_BASE_URL when both are set, and points
#  at the full endpoint. Responses mode also falls back to ANTHROPIC_BASE_URL
#  and ANTHROPIC_API_KEY, so switching one variable is often enough.
# =============================================================================


# =============================================================================
#  Anthropic-compatible providers
#
#  Provider         MODEL_ID                    Notes                 Base URL
#  ---------------  --------------------------  --------------------  -------------------
#  Anthropic        claude-sonnet-4-6           default               (default)
#  MiniMax          MiniMax-M3                  latest M-series       see below
#  GLM (Zhipu)      glm-5.2                     latest coding model   see below
#  Kimi (Moonshot)  kimi-k2.7-code              coding model          see below
#  DeepSeek         deepseek-v4-pro             pro model             see below
#                   deepseek-v4-flash           flash model           see below
#
#  Check provider docs for current availability, pricing, and regional access.
#
#  NOTE: "Anthropic-compatible" does not guarantee identical model behavior.
#  Providers may differ in supported parameters, reasoning/thinking defaults,
#  response content blocks, and tool-use history requirements. These teaching
#  examples do not normalize provider-specific behavior. Check the provider's
#  current documentation, or use the default Anthropic setup for the most
#  predictable course experience.
# =============================================================================

# ---- International ----

